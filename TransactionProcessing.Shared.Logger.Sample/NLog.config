<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">
  <targets>
    <target xsi:type="File"
            name="structuredJsonFile"
            fileName="${basedir}/logs/${whenEmpty:inner=${scopeproperty:item=tenantId}:whenEmpty=}/structured-logger-${shortdate}.json"
            keepFileOpen="false">
      <layout xsi:type="JsonLayout"
              includeEventProperties="true"
              excludeProperties="timestampUtc">
        <attribute name="timestampUtc" layout="${date:universalTime=true:format=o}" />
        <attribute name="level" layout="${level:uppercase=true}" />
        <attribute name="message" layout="${message}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="*" minlevel="Trace" writeTo="structuredJsonFile" />
  </rules>
</nlog>
